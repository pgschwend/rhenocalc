/* === Base === */
QWidget {
    background-color: @L22@;
    color: @L05@;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}
QMainWindow, QDialog {
    background-color: @L22@;
}

/* === GroupBox === */
QGroupBox {
    background-color: @L24@;
    border: 1px solid @L18@;
    border-radius: 8px;
    padding-top: 18px;
    margin-top: 14px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 3px;
    padding: 0 6px;
    color: @L08@;
    background-color: @L24@;
}

/* === Tabs === */
QTabWidget::pane {
    border: 1px solid @L18@;
    border-radius: 0 6px 6px 6px;
    background-color: @L22@;
    top: -1px;
}
QTabBar {
    background: transparent;
}
QTabBar::tab {
    background-color: @L21@;
    color: @L12@;
    border: 1px solid @L18@;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 16px;
    margin-right: 3px;
    font-size: 12px;
}
QTabBar::tab:selected {
    background-color: @L22@;
    color: @L05@;
    border-bottom: 2px solid @L08@;
}
QTabBar::tab:hover:!selected {
    background-color: @L19@;
    color: @L06@;
}

/* === Tables === */
QTableWidget, QTableView {
    background-color: @L24@;
    gridline-color: @L20@;
    border: 1px solid @L18@;
    border-radius: 6px;
    alternate-background-color: @L23@;
    outline: none;
}
QTableWidget::item, QTableView::item {
    padding: 5px 10px;
    border: none;
    color: @L05@;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: @L08@;
    color: @L24@;
}
QTableWidget::item:hover, QTableView::item:hover {
    background-color: @L17@;
    color: @L05@;
}
QHeaderView::section {
    background-color: @L21@;
    color: @L08@;
    padding: 7px 10px;
    border: none;
    border-right: 1px solid @L18@;
    border-bottom: 2px solid @L18@;
    font-weight: bold;
    font-size: 12px;
}
QHeaderView::section:last {
    border-right: none;
}

/* === Buttons === */
QPushButton {
    background-color: @L08@;
    color: @L24@;
    border: none;
    border-radius: 6px;
    padding: 7px 18px;
    font-weight: bold;
    font-size: 13px;
    //min-height: 22px;
}
QPushButton:hover {
    background-color: @L10@;
}
QPushButton:pressed {
    background-color: @L07@;
}
QPushButton:disabled {
    background-color: @L16@;
    color: @L14@;
}

/* === Line Edit & SpinBox === */
QLineEdit, QSpinBox {
    background-color: @L24@;
    border: 1px solid @L16@;
    border-radius: 6px;
    padding: 6px 10px;
    color: @L05@;
    min-height: 22px;
    selection-background-color: @L08@;
    selection-color: @L24@;
}
QLineEdit:hover, QSpinBox:hover {
    border-color: @L15@;
}
QLineEdit:focus, QSpinBox:focus {
    border: 2px solid @L08@;
    padding: 5px 9px;
}
QSpinBox::up-button, QSpinBox::down-button {
    background-color: @L21@;
    border: none;
    border-radius: 3px;
    width: 16px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: @L16@;
}

/* === ComboBox === */
QComboBox {
    background-color: @L24@;
    border: 1px solid @L16@;
    border-radius: 6px;
    padding: 6px 10px;
    color: @L05@;
    min-height: 22px;
    selection-background-color: @L15@;
}
QComboBox:hover {
    border-color: @L15@;
}
QComboBox:focus {
    border: 2px solid @L08@;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 28px;
    border: none;
    border-left: 1px solid @L16@;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: @L21@;
}
QComboBox::drop-down:hover {
    background-color: @L16@;
}
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background-color: @L24@;
    border: 1px solid @L16@;
    border-radius: 6px;
    selection-background-color: @L08@;
    selection-color: @L24@;
    padding: 4px;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 7px 10px;
    border-radius: 4px;
    min-height: 22px;
    color: @L05@;
}
QComboBox QAbstractItemView::item:hover {
    background-color: @L09@;
    color: @L24@;
}
QComboBox QAbstractItemView::item:selected {
    background-color: @L08@;
    color: @L24@;
}

/* === Popup-Fallback: QAbstractItemView wird als Top-Level-Fenster gerendert === */
QAbstractItemView {
    background-color: @L24@;
    color: @L05@;
    border: 1px solid @L16@;
    selection-background-color: @L08@;
    selection-color: @L24@;
    outline: none;
}
QAbstractItemView::item {
    color: @L05@;
    padding: 6px 10px;
}
QAbstractItemView::item:hover {
    background-color: @L09@;
    color: @L24@;
}
QAbstractItemView::item:selected {
    background-color: @L08@;
    color: @L24@;
}

/* === TextEdit === */
QTextEdit, QPlainTextEdit {
    background-color: @L24@;
    border: 1px solid @L18@;
    border-radius: 6px;
    color: @L05@;
    padding: 6px;
    selection-background-color: @L08@;
    selection-color: @L24@;
}

/* === Scrollbar (thin, no arrows) === */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 2px 2px 0;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: @L16@;
    border-radius: 4px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background: @L15@;
}
QScrollBar::handle:vertical:pressed {
    background: @L08@;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0 2px 2px 2px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: @L16@;
    border-radius: 4px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover {
    background: @L15@;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
    border: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* === Labels === */
QLabel {
    color: @L05@;
    background: transparent;
}

/* === List Widget === */
QListWidget {
    background-color: @L24@;
    border: 1px solid @L18@;
    border-radius: 6px;
    outline: none;
    padding: 4px;
}
QListWidget::item {
    padding: 6px 10px;
    border-radius: 4px;
    color: @L05@;
}
QListWidget::item:selected {
    background-color: @L08@;
    color: @L24@;
}
QListWidget::item:hover {
    background-color: @L17@;
    color: @L05@;
}

/* === CheckBox / RadioButton === */
QCheckBox, QRadioButton {
    color: @L05@;
    spacing: 7px;
    background: transparent;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 2px solid @L16@;
    background-color: @L24@;
}
QCheckBox::indicator:checked {
    background-color: @L08@;
    border-color: @L08@;
}
QCheckBox::indicator:hover {
    border-color: @L15@;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid @L16@;
    background-color: @L24@;
}
QRadioButton::indicator:checked {
    background-color: @L08@;
    border-color: @L08@;
}

/* === ToolTip === */
QToolTip {
    background-color: @L24@;
    color: @L05@;
    border: 1px solid @L16@;
    border-radius: 5px;
    padding: 5px 9px;
}

/* === Menu === */
QMenu {
    background-color: @L24@;
    border: 1px solid @L16@;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 4px;
    color: @L05@;
}
QMenu::item:selected {
    background-color: @L08@;
    color: @L24@;
}
QMenu::separator {
    height: 1px;
    background: @L18@;
    margin: 4px 8px;
}

/* === ScrollArea === */
QScrollArea {
    border: 1px solid @L18@;
    border-radius: 6px;
    background-color: @L24@;
}

/* === Frame lines === */
QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: @L18@;
}

/* === ProgressBar === */
QProgressBar {
    background-color: @L21@;
    border: 1px solid @L16@;
    border-radius: 4px;
    text-align: center;
    color: @L05@;
    min-height: 10px;
}
QProgressBar::chunk {
    background-color: @L08@;
    border-radius: 3px;
}

/* ============================================================
   Widget-spezifische Stile (via ObjectName)
   ============================================================ */

/* Settings – Theme-Hinweis */
QLabel#themeHintLabel {
    color: @L11@;
    font-size: 11px;
}

/* Info-Seite – App-Icon */
QLabel#appIconLabel {
    font-size: 24px;
    font-weight: bold;
}

/* Beschreibungs-Labels mit Zeilenabstand */
QLabel#settingsInfoLabel,
QLabel#nmapInfoLabel,
QLabel#appDescriptionLabel {
    line-height: 1.5;
}
QLabel#appFeaturesLabel {
    line-height: 1.6;
}

/* Status-Labels – gedimmt/kursiv */
QLabel#wifiStatusLabel,
QLabel#btScanStatusLabel {
    color: @L11@;
    font-style: italic;
}

/* Nmap-Status */
QLabel#nmapStatusLabel {
    color: @L11@;
    font-weight: bold;
}

/* Modbus – dynamischer Verbindungsstatus (via Property "status") */
QLabel#rtuStatusLabel[status="disconnected"],
QLabel#tcpStatusLabel[status="disconnected"] {
    color: @L13@;
    font-weight: normal;
}
QLabel#rtuStatusLabel[status="connected"],
QLabel#tcpStatusLabel[status="connected"] {
    color: @L02@;
    font-weight: bold;
}

/* REST API – Send-Button (Akzentfarbe) */
QPushButton#sendRequestButton {
    background-color: @L03@;
}
QPushButton#sendRequestButton:hover {
    background-color: @L04@;
}
QPushButton#sendRequestButton:pressed {
    background-color: @L01@;
}

/* REST API – HTTP-Status-Code */
QLabel#httpStatusCodeLabel {
    font-weight: bold;
    font-size: 12px;
}

/* REST API – Anfrage-Status */
QLabel#requestStatusLabel {
    color: @L11@;
}


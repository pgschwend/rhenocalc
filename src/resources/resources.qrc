<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/styles">
        <file alias="dark.qss">styles/dark.qss</file>
        <file alias="light.qss">styles/light.qss</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="rhenocalc.svg">icons/rhenocalc.svg</file>
    </qresource>
    <qresource prefix="/symbols">
        <file alias="pin_gray.svg">symbols/pin_gray.svg</file>
    </qresource>
</RCC>


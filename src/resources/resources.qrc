<RCC version="1.0">
    <qresource prefix="/styles">
        <file alias="dark.qss">styles/dark.qss</file>
        <file alias="light.qss">styles/light.qss</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="calculator.svg">icons/calculator.svg</file>
    </qresource>
</RCC>

